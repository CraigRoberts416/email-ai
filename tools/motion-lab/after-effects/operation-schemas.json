{
  "verifiedAt": "2026-09-19",
  "source": "fnf-after-effects-mcp local ae_catalog via external SDK",
  "operations": [
    {
      "name": "batch.run",
      "description": "Execute multiple operations in a single IPC call (~400ms total instead of 400ms \u00d7 N). Operations run sequentially inside ONE undo group \u2014 a single Ctrl+Z reverts the whole batch, however many ops it contained. That group is also why undo/redo children (project.undo, command.execute id 16/2035) are rejected here: call those as their own ae_do. If one fails, subsequent ops still run unless stopOnError. Results array matches input order; the response reports how many failed. Mix in read/verify children \u2014 comp.info, layer.info, render.frame \u2014 to mutate AND verify in the same call, e.g. [...mutations, { operation: 'render.frame', args: { \u2026 } }].",
      "readOnly": true,
      "params": [
        {
          "name": "ops",
          "type": "array",
          "required": true,
          "description": "Array of { operation, args } objects, e.g. [{ \"operation\": \"layer.create_solid\", \"args\": { \"comp\": \"Main\", \"color\": [1,0,0] } }]"
        },
        {
          "name": "stopOnError",
          "type": "boolean",
          "required": false,
          "description": "Stop executing remaining ops if one fails (default false)"
        }
      ]
    },
    {
      "name": "comp.create",
      "description": "Create a new composition.",
      "readOnly": false,
      "params": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Composition name"
        },
        {
          "name": "width",
          "type": "number",
          "required": true,
          "description": "Width in px"
        },
        {
          "name": "height",
          "type": "number",
          "required": true,
          "description": "Height in px"
        },
        {
          "name": "fps",
          "type": "number",
          "required": true,
          "description": "Frame rate"
        },
        {
          "name": "duration",
          "type": "number",
          "required": true,
          "description": "Duration in seconds"
        },
        {
          "name": "bgColor",
          "type": "array",
          "required": false,
          "description": "[r,g,b] 0-1"
        }
      ]
    },
    {
